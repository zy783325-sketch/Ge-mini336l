<?xml version="1.0"?>
<package format="3">
  <name>pointcloud_fusion</name>
  <version>0.1.0</version>
  <description>Transform and merge front and rear lidar PointCloud2 data.</description>
  <maintainer email="maintainer@example.com">Wheeltec ROS 2 users</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
